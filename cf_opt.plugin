[General]
name = ⚡️ Cloudflare 动态优选与分地区生成器 (严格实测版)
desc = 拦截虚拟订阅请求，支持按每个国家地区保留 N 个节点（如港2个、日2个、美2个等），严格实测过滤并输出 100% 全绿可用的 Loon 原生节点！
author = Antigravity
homepage = https://github.com/xw-yin/loon-cf-opt
version = 5.1.0

[Script]
# HTTP 重写拦截：拦截对虚拟订阅地址的访问，动态实时测速并返回最优节点
http-request ^https?:\/\/httpbin\.org\/cf_sub script-path=https://raw.githubusercontent.com/xw-yin/loon-cf-opt/main/cf_sub_reader.js?v=51, argument=[{uuid},{host},{path},{port},{protocol},{test_scale},{retest},{limit_per_country},{total_limit},{timeout},{custom_source}], timeout=30, tag=CF实时优选节点生成

[Argument]
uuid = input, "a2a71d1c-5be9-4837-89ac-67125bfd0d28", tag=UUID / 密码, desc=填入你的 VLESS UUID 或 Trojan 密码
host = input, "peter.yxw.pp.ua", tag=Worker 域名, desc=填入绑定你的 Worker/Pages 自定义域名
path = input, "/video", tag=连接路径, desc=填入传输路径 (如 /video 或 /)
port = select, "auto", "443", "2096", "8443", "2053", "2083", "2087", "80", "8080", "8880", "2052", "2082", "2086", "2095", tag=端口, desc=推荐 auto 自动继承各节点最佳测速端口，避免被 QoS 阻断
protocol = select, "vless", "trojan", tag=协议类型, desc=默认使用 VLESS
test_scale = select, "50", "20", "35", "80", "100", "150", "200", tag=测速筛选规模, desc=候选池测速样本数，支持最大 200 个 IP 分批并发测速
retest = select, "true", "false", tag=开启严格本地二次实测, desc=开启后只输出本地 100% 实测全通的节点，彻底剔除 Timeout 节点
limit_per_country = select, "2", "1", "3", "4", "5", tag=每个国家/地区保留节点数, desc=如设为 2，则香港/台湾/日本/新加坡/美国各保留 2 个最优节点
total_limit = select, "10", "5", "8", "15", "20", "30", tag=节点总输出上限, desc=最终输出到 Loon 的最大节点总数
timeout = select, "1500", "1000", "2000", "3000", tag=二次测速超时 (ms), desc=单节点二次探测最大允许时间
custom_source = input, "", tag=自定义优选源, desc=选填：用英文逗号分隔的IP或存放优选IP的URL链接

[MITM]
# 必须解密目标测试域名，以劫持我们的虚拟订阅路径
hostname = httpbin.org
