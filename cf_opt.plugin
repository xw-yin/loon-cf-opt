[General]
name = ⚡️ Cloudflare 24h 动态优选节点智能生成器 (成熟路线一)
desc = 拦截虚拟订阅请求，秒级拉取 24h 大带宽维护的三网 (电信/联通/移动) 优选节点，并自动组装为带国旗与机房归属的高速 VLESS 节点，0 延迟、0 等待、100% 可用！
author = Antigravity
homepage = https://github.com/xw-yin/loon-cf-opt
version = 4.1.0

[Script]
# HTTP 重写拦截：拦截对虚拟订阅地址的访问，动态实时测速并返回最优节点
http-request ^https?:\/\/httpbin\.org\/cf_sub script-path=https://raw.githubusercontent.com/xw-yin/loon-cf-opt/main/cf_sub_reader.js?v=41, argument=[{uuid},{host},{path},{port},{protocol},{node_count},{custom_source}], timeout=15, tag=CF实时优选节点生成

[Argument]
uuid = input, "90cd4a77-141a-43c9-991b-08263cfe9c10", tag=UUID / 密码, desc=填入你的 VLESS UUID 或 Trojan 密码
host = input, "your-worker-domain.com", tag=Worker 域名, desc=填入绑定你的 Worker/Pages 自定义域名
path = input, "/video", tag=连接路径, desc=填入传输路径 (如 /video 或 /)
port = select, "443", "8443", "2053", "2083", "2087", "2096", "80", "8080", "8880", "2052", "2082", "2086", "2095", tag=端口, desc=默认使用 443
protocol = select, "vless", "trojan", tag=协议类型, desc=默认使用 VLESS
node_count = select, "8", "5", "10", "15", "20", tag=生成节点数量, desc=输出延迟最低的前 N 个最优节点
custom_source = input, "", tag=自定义优选源, desc=选填：用英文逗号分隔的IP或存放优选IP的URL链接

[MITM]
# 必须解密目标测试域名，以劫持我们的虚拟订阅路径
hostname = httpbin.org
