lmjpxmvi_enable = switch,true,false,tag=解除微信链接限制-脚本开关
xhs_enable = switch,true,false,tag=小红书-脚本开关


optimizeRequest = switch,true,tag=bilibili-优化请求
purifyComment = switch,true,tag=bilibili-过滤评论推广
sponsorBlock = switch,false,tag=bilibili-空降助手,desc=跳过视频中插入的广告；片段数据来自第三方 bsbsb.top，默认关
displayUpList = select,"show","hide","auto",tag=bilibili-动态页UP列表,desc=auto：仅当列表中存在直播状态时显示；show：始终显示；hide：始终隐藏
