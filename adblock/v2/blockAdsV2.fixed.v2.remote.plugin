itzj_enable = switch,true,false,tag=IT之家-脚本开关
jkds_enable = switch,true,false,tag=京东-脚本开关
HomeClean = switch,true,tag=京东-首页净化
OrderAds = switch,true,tag=京东-订单页净化
ProfileClean = switch,true,tag=京东-我的页净化
ProductClean = switch,true,tag=京东-商品页净化
kuan_enable = switch,true,false,tag=酷安-脚本开关
