# Spotify（v2.8.0 整合自 fking 版 Spotify_remove_ads，参数与原插件一一对应）
tab = switch,false,true,tag=移除底栏创建按钮,desc=此开关控制是否移除底栏创建按钮
useractivity = switch,true,false,tag=启用Apple设备接力,desc=此开关控制是否使用Apple设备接力
# YouTube（v2.10.0 改用 Kelee 收录的 Maasea 版「YouTube去广告」，参数与原插件一一对应；核心去广告绑定常开，无总开关）
blockUpload = switch,false,true,tag=YouTube-隐藏上传按钮,desc=隐藏 YouTube 底栏的上传（创建）按钮
blockShorts = switch,false,true,tag=YouTube-隐藏Shorts按钮,desc=隐藏 YouTube 底栏的 Shorts 按钮
blockImmersive = switch,false,true,tag=YouTube-隐藏选段按钮,desc=隐藏 YouTube Music 底栏的选段按钮
captionLang = select,"zh-Hans","zh-Hant","ja","ko","en","off",tag=YouTube-字幕翻译语言,desc=把已有字幕翻译为所选语言，off 为不翻译。视频没有字幕轨时无字幕可翻
debug = switch,false,true,tag=YouTube-调试模式,desc=Maasea 脚本的调试模式，平时保持关闭
vihu_enable = switch,true,false,tag=知乎-脚本开关
davsdmpk_enable = switch,true,false,tag=大众点评-脚本开关
yzku_enable = switch,true,false,tag=优酷-脚本开关

removePinnedArticles = switch, false, true, tag=移除置顶文章, desc=启用后将移除置顶文章
removeAllBanners = switch, false, true, tag=移除全部横幅, desc=启用后将移除全部横幅
